# Server-only configuration. Copy to a git-ignored .env file; do not paste keys into chat.
GOOGLE_PLACES_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Non-secret provider/model/primary/backup settings: system_parameters[ai.providers].
# Optional compatible endpoints: comma-separated exact HTTPS URLs, no query strings.
AI_ALLOWED_COMPATIBLE_ENDPOINTS=
# Each compatible profile uses its own AI_COMPAT_<NAME>_API_KEY secret.
# V2 secret key, with only subscriptions:read and products:read (see REVENUECAT.md).
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=proj66f64377
# App Store product identifiers, not RevenueCat's internal prod... IDs.
REVENUECAT_PRO_PRODUCT_IDS=au.iapp.lunch.pro.monthly,au.iapp.lunch.pro.yearly
REVENUECAT_WEBHOOK_SECRET=
# Apple sandbox receipts are needed for TestFlight/App Review. Test Store receipts are always rejected.
REVENUECAT_ALLOW_APPLE_SANDBOX=false
APPLE_CLIENT_ID=au.iapp.lunch
APPLE_TEAM_ID=RYM9BD2B27
APPLE_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=
FCM_SERVICE_ACCOUNT_JSON=
INVITE_LINK_BASE=https://lunch.iapp.au/i/
# Global UTC daily API request ceilings. Configure provider quotas and billing alerts as well.
PLACES_DAILY_REQUEST_LIMIT=1000
PHOTOS_DAILY_REQUEST_LIMIT=3000
AI_DAILY_REQUEST_LIMIT=500
