{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "What We Have For Lunch",
    "version": "2.0.0",
    "source": "Paprika rebrand of 2026-10-07: warm palette, Bricolage Grotesque headlines over each platform's system text face. Supersedes the green palette reconciled from the Flutter theme on 2026-09-02.",
    "generatedInto": [
      "iosApp/LunchApp/DesignSystem/Tokens.swift",
      "androidApp/src/main/kotlin/au/iapp/lunch/ui/theme/Tokens.kt"
    ]
  },
  "color": {
    "ground":          { "light": "#FFF6EC", "dark": "#1A1310", "role": "Screen background. Warm cream; espresso in dark, never green-black." },
    "surface":         { "light": "#FFFFFF", "dark": "#261C17", "role": "Cards, inputs, sheets." },
    "surfaceRaised":   { "light": "#FFF0E0", "dark": "#33261F", "role": "Nested cards, tab bar, tags." },
    "text":            { "light": "#3A2218", "dark": "#F5E9DD", "role": "Body text." },
    "textSecondary":   { "light": "#7A5A48", "dark": "#C4AE9C", "role": "Captions, hints, unselected tabs." },
    "textOnPrimary":   { "light": "#FFFFFF", "dark": "#3A1206", "role": "Text on primary fills." },
    "textOnAction":    { "light": "#FFFFFF", "dark": "#2A0E03", "role": "Text on the action fill. Large bold labels only in light (3.7:1)." },
    "primary":         { "light": "#C63D17", "dark": "#FF8A5B", "role": "Paprika. Structure, selected states, primary buttons." },
    "primarySoft":     { "light": "#C63D171A", "dark": "#FF8A5B29", "role": "Tinted fills (10% / 16%)." },
    "action":          { "light": "#EC4E14", "dark": "#FF6B35", "role": "The Hungry button and the paywall button only." },
    "actionSoft":      { "light": "#EC4E141F", "dark": "#FF6B3529", "role": "Rings and glows around the action." },
    "accent":          { "light": "#D98A00", "dark": "#FFC154", "role": "Saffron. Rating stars; decorative, always next to the rating number." },
    "success":         { "light": "#2E7D4F", "dark": "#7FD19B", "role": "Positive badges and a healthy budget. The only green in the palette." },
    "warning":         { "light": "#A85A00", "dark": "#FFB868", "role": "Caution badges." },
    "danger":          { "light": "#A8123E", "dark": "#FF8FA8", "role": "Errors, destructive actions. Berry, so it never reads as the paprika brand colour." },
    "info":            { "light": "#1F5F8B", "dark": "#8CC8F2", "role": "Neutral information badges." },
    "hairline":        { "light": "#3A221824", "dark": "#FFFFFF1F", "role": "Card borders, dividers (14% / 12%)." },
    "hairlineStrong":  { "light": "#3A221847", "dark": "#FFFFFF3D", "role": "Focused borders, strong dividers." },
    "scrim":           { "light": "#2A181099", "dark": "#000000A6", "role": "Behind sheets and dialogs." }
  },
  "typography": {
    "family": { "display": "Bricolage Grotesque", "body": "system", "fallback": "system-ui" },
    "roles": {
      "display":  { "size": 32, "weight": 800, "lineHeight": 38, "tracking": -0.5, "family": "display" },
      "title":    { "size": 22, "weight": 700, "lineHeight": 28, "tracking": -0.2, "family": "display" },
      "heading":  { "size": 17, "weight": 700, "lineHeight": 22, "tracking": 0, "family": "display" },
      "body":     { "size": 16, "weight": 500, "lineHeight": 24, "tracking": 0.15, "family": "body" },
      "bodySmall":{ "size": 14, "weight": 400, "lineHeight": 20, "tracking": 0.25, "family": "body" },
      "caption":  { "size": 13, "weight": 500, "lineHeight": 18, "tracking": 0.2, "family": "body" },
      "label":    { "size": 11, "weight": 700, "lineHeight": 16, "tracking": 1.2, "uppercase": true, "family": "body" },
      "button":   { "size": 16, "weight": 700, "lineHeight": 20, "tracking": 0.1, "family": "body" }
    },
    "textScale": { "min": 0.8, "max": 2.0 }
  },
  "spacing": { "unit": 4, "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 32, "xxl": 48, "page": 16, "pageWide": 24 },
  "radius": { "container": 16, "chip": 9999, "toast": 12, "sheet": 24, "hero": 9999, "input": 16, "button": 16 },
  "size": {
    "touchTarget": 44,
    "buttonHeight": 52,
    "buttonMinWidth": 48,
    "heroButton": 224,
    "heroRingInner": 256,
    "heroRingOuter": 288,
    "heroBorder": 8,
    "tabIcon": 24,
    "iconDefault": 24,
    "capacityRingStroke": 12
  },
  "elevation": {
    "card":   { "y": 2, "blur": 8,  "alpha": 0.04 },
    "hero":   { "y": 10, "blur": 25, "alpha": 0.40, "colorRef": "action" },
    "sheet":  { "y": -4, "blur": 24, "alpha": 0.12 }
  },
  "motion": {
    "state": { "duration": 200, "easing": "easeOut" },
    "press": { "duration": 100, "scale": 0.95 },
    "heroPulse": { "duration": 2400, "scaleOuter": 1.04, "scaleInner": 1.025, "respectsReducedMotion": true },
    "sheet": { "duration": 300, "easing": "easeInOut" },
    "fadeIn": { "duration": 300, "easing": "easeInOut" },
    "achievementToast": { "autoDismiss": 4000 }
  },
  "icons": {
    "family": "Material Symbols Rounded",
    "weight": 400,
    "selectedTabFill": true,
    "exportFormat": "svg",
    "set": [
      "home", "explore", "analytics", "person", "restaurant", "restaurant_menu", "local_fire_department",
      "notifications", "search", "expand_more", "filter_list", "favorite", "star", "payments", "near_me",
      "arrow_back", "chevron_right", "close", "check", "add", "history", "schedule", "calendar_today",
      "location_on", "directions", "map", "tune", "shield", "help", "info", "celebration", "eco",
      "psychology", "delivery_dining", "takeout_dining", "shopping_cart", "local_cafe", "attach_money",
      "group", "group_add", "share", "event", "event_available", "event_busy", "mail", "send",
      "workspace_premium", "lock", "lock_open", "refresh", "error", "wifi_off", "cloud_off",
      "auto_awesome", "edit", "delete", "download", "logout", "login", "settings", "visibility",
      "visibility_off", "more_horiz"
    ]
  }
}
