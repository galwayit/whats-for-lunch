    { "name": "adjusted amounts are final amounts after surcharge", "billCents": 10000, "surchargeBps": 1000, "people": 3, "fixed": { "0": 5000 },
      "totalCents": 11000, "surchargeCents": 1000, "shares": [5000, 3000, 3000] },
    { "name": "adjusted person covers the whole bill", "billCents": 5000, "surchargeBps": 0, "people": 3, "fixed": { "0": 5000 },
      "totalCents": 5000, "surchargeCents": 0, "shares": [5000, 0, 0] },
    { "name": "everyone adjusted and it adds up", "billCents": 5000, "surchargeBps": 0, "people": 2, "fixed": { "0": 2500, "1": 2500 },
      "totalCents": 5000, "surchargeCents": 0, "shares": [2500, 2500] },
    { "name": "adjusted amounts exceed the bill", "billCents": 5000, "surchargeBps": 0, "people": 2, "fixed": { "0": 6000 },
      "error": "OVER_ALLOCATED", "differenceCents": 1000 },
    { "name": "everyone adjusted but short of the bill", "billCents": 5000, "surchargeBps": 0, "people": 2, "fixed": { "0": 2000, "1": 2000 },
      "error": "UNDER_ALLOCATED", "differenceCents": 1000 },
    { "name": "no bill amount", "billCents": 0, "surchargeBps": 0, "people": 2, "fixed": {},
