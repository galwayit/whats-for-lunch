    { "name": "even split exact", "billCents": 12000, "surchargeBps": 0, "people": 4, "fixed": {},
      "totalCents": 12000, "surchargeCents": 0, "shares": [3000, 3000, 3000, 3000] },
    { "name": "one cent across three", "billCents": 1, "surchargeBps": 0, "people": 3, "fixed": {},
      "totalCents": 1, "surchargeCents": 0, "shares": [1, 0, 0] },
    { "name": "single person pays everything", "billCents": 2350, "surchargeBps": 0, "people": 1, "fixed": {},
      "totalCents": 2350, "surchargeCents": 0, "shares": [2350] },
    { "name": "public holiday surcharge 10 percent", "billCents": 8550, "surchargeBps": 1000, "people": 2, "fixed": {},
      "totalCents": 9405, "surchargeCents": 855, "shares": [4703, 4702] },
    { "name": "card surcharge 1.5 percent rounds down below half", "billCents": 4999, "surchargeBps": 150, "people": 3, "fixed": {},
      "totalCents": 5074, "surchargeCents": 75, "shares": [1692, 1691, 1691] },
    { "name": "surcharge rounds half up", "billCents": 100, "surchargeBps": 50, "people": 2, "fixed": {},
      "totalCents": 101, "surchargeCents": 1, "shares": [51, 50] },
    { "name": "one person adjusted, rest rebalance", "billCents": 12000, "surchargeBps": 0, "people": 4, "fixed": { "1": 500 },
