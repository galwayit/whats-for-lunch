-- Verbatim from fixtures/drift_schema_v6.sql (Drift schema version 6).
CREATE TABLE "a_i_recommendation_feedback" ("id" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, "recommendation_id" TEXT NOT NULL REFERENCES a_i_recommendations (id), "user_id" INTEGER NOT NULL REFERENCES users (id), "place_id" TEXT NOT NULL REFERENCES restaurants (place_id), "rating" INTEGER NOT NULL, "feedback_text" TEXT, "was_selected" INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0 CHECK ("was_selected" IN (0, 1)), "submitted_at" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));

insert:
INSERT INTO a_i_recommendation_feedback (recommendation_id, user_id, place_id, rating, feedback_text, was_selected, submitted_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectByRecommendation:
SELECT * FROM a_i_recommendation_feedback WHERE recommendation_id = ? ORDER BY submitted_at DESC;

selectByUser:
SELECT * FROM a_i_recommendation_feedback WHERE user_id = ? ORDER BY submitted_at DESC LIMIT ?;
